# Copy to .env in the repo root, then link it for Prisma:
#   cp .env.example .env
#   ln -sfn ../../.env apps/api/.env
#
# DATABASE_URL must match the user, password, db name, and host port in docker-compose.yml.

DATABASE_URL=postgresql://slop:slop@localhost:54329/slop_registry

# Optional. Public repos work without it (60 GitHub requests/hour).
# A token with public-repo read access raises that to 5,000/hour.
# Leave blank to stay unauthenticated. Do not commit a real token.
GITHUB_TOKEN=

# Required for classify, cluster, and invariant drafts. Unit tests mock the
# model and do not read this. Leave it blank until you run the real pipeline.
OPENAI_API_KEY=

# Chat model for classification and invariant drafts. Default gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# How many classification requests to run at once. Default 4. Integers 1 to 16.
CLASSIFY_CONCURRENCY=4

# API listen port. The web page calls this.
PORT=43124

# Browser origin allowed to call the API (CORS).
WEB_ORIGIN=http://127.0.0.1:43123

# Baked into the Next.js page. Must point at the API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:43124
