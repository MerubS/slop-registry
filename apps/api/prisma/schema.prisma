// Day 1 stores review comments. Day 2 fills bucket, category, reason,
// and embedding. Those columns were on the model from the start so this
// step did not need a new migration.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector's SQL extension is named "vector". Prisma's schema name is pgvector.
  extensions = [pgvector(map: "vector")]
}

model Repo {
  id         String          @id @default(cuid())
  // "owner/repo", exactly as the request spelled it. GitHub itself is
  // case-insensitive; this column is not. See the explainer.
  fullName   String          @unique
  fetchedAt  DateTime
  comments   ReviewComment[]
  invariants Invariant[]
}

model ReviewComment {
  // GitHub's comment id. Primary key so a second ingest updates the row
  // instead of inserting a duplicate. BigInt because the plan asks for it
  // and because these ids will not fit in a 32-bit int. They still fit in
  // a JS number today (under 2^53), so the client can pass them safely.
  id        BigInt   @id
  repoId    String
  repo      Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  prNumber  Int
  author    String
  isBot     Boolean
  path      String?
  body      String
  htmlUrl   String
  createdAt DateTime

  // Null bucket means "not classified". Classify skips a row that already
  // has one. Re-ingest must not overwrite these. The upsert update clause
  // omits them, so an edited body keeps the old label.
  bucket   String?
  category String?
  reason   String?

  // 1536 is the default size of OpenAI text-embedding-3-small. Prisma has
  // no vector type, so this column is Unsupported: the database has it,
  // the Prisma client cannot read or write it. ClusterService writes it
  // with SQL. Select a specific field list on Prisma writes so Prisma
  // does not try to return this column.
  embedding Unsupported("vector(1536)")?

  @@index([repoId])
}

model Invariant {
  id               String   @id @default(cuid())
  repoId           String
  repo             Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  title            String
  assertion        String
  category         String?
  fileGlob         String?
  clusterSize      Int      @default(0)
  sourceCommentIds BigInt[] @default([])
  createdAt        DateTime @default(now())
}
