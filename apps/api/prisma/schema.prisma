// Day 1 stores review comments. Day 2 fills bucket, category, reason,
// and embedding. inReplyToId and diffHunk were added after the first
// aviator-co/av run, in the comment_threads migration. That migration
// also clears the first-run labels and embeddings once.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector's SQL extension is named "vector". Prisma's schema name is pgvector.
  extensions = [pgvector(map: "vector")]
}

model Repo {
  id         String          @id @default(cuid())
  // "owner/repo", exactly as the request spelled it. GitHub itself is
  // case-insensitive; this column is not. See the explainer.
  fullName   String          @unique
  fetchedAt  DateTime
  comments   ReviewComment[]
  invariants Invariant[]
}

model ReviewComment {
  // GitHub's comment id. Primary key so a second ingest updates the row
  // instead of inserting a duplicate. BigInt because the plan asks for it
  // and because these ids will not fit in a 32-bit int. They still fit in
  // a JS number today (under 2^53), so the client can pass them safely.
  id        BigInt   @id
  repoId    String
  repo      Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  prNumber  Int
  author    String
  isBot     Boolean
  path      String?
  body      String
  htmlUrl   String
  createdAt DateTime

  // GitHub's in_reply_to_id. Null means this comment starts the thread,
  // which is the review we classify. A reply points at its parent. Replies
  // are context for that root. They are not classified or clustered, and
  // they are left out of the bucket split.
  inReplyToId BigInt?

  // The diff the comment is attached to. Classify passes the hunk with
  // the thread. The embedding may include a short excerpt of the changed
  // lines, never the path. The path is only for the file glob.
  diffHunk String? @db.Text

  // Null bucket means "not classified". Classify skips a row that already
  // has one. Re-ingest must not overwrite these. The upsert update clause
  // omits them, so an edited body keeps the old label.
  bucket   String?
  category String?
  reason   String?

  // 1536 is the default size of OpenAI text-embedding-3-small. Prisma has
  // no vector type, so this column is Unsupported: the database has it,
  // the Prisma client cannot read or write it. ClusterService writes it
  // with SQL. Select a specific field list on Prisma writes so Prisma
  // does not try to return this column.
  embedding Unsupported("vector(1536)")?

  @@index([repoId])
}

model Invariant {
  id               String   @id @default(cuid())
  repoId           String
  repo             Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  title            String
  assertion        String
  category         String?
  fileGlob         String?
  // Supporting comments that state the rule, not the raw cluster size.
  // supportCount is the same number under an honest name.
  clusterSize      Int      @default(0)
  supportCount     Int      @default(0)
  // Distinct pull requests among those supporting comments. This is the
  // "seen in N pull requests" figure. It is not the raw cluster's PR count.
  prCount          Int      @default(0)
  sourceCommentIds BigInt[] @default([])
  createdAt        DateTime @default(now())
}
